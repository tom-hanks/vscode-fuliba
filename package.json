{
  "name": "fuliba",
  "displayName": "福利吧",
  "description": "码农摸鱼神器：在 VS Code 侧边栏里刷福利吧。等编译、等依赖、等 AI 把代码写完的间隙，顺手翻两页，不用切浏览器。",
  "version": "0.9.0",
  "publisher": "laryers",
  "license": "MIT",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#7A2B1A",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tom-hanks/vscode-fuliba"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "fuliba",
    "discuz",
    "forum",
    "福利吧",
    "摸鱼"
  ],
  "activationEvents": [
    "onView:fuliba-forums",
    "onCommand:fuliba.setCookie",
    "onCommand:fuliba.openThread",
    "onCommand:fuliba.openArticle"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fuliba.setCookie",
        "title": "导入 Cookie",
        "category": "福利吧",
        "icon": "$(key)"
      },
      {
        "command": "fuliba.clearCookie",
        "title": "清除 Cookie",
        "category": "福利吧"
      },
      {
        "command": "fuliba.refreshForums",
        "title": "刷新版块",
        "category": "福利吧",
        "icon": "$(refresh)"
      },
      {
        "command": "fuliba.refreshNode",
        "title": "刷新",
        "category": "福利吧",
        "icon": "$(refresh)"
      },
      {
        "command": "fuliba.openThread",
        "title": "打开指定帖子",
        "category": "福利吧",
        "icon": "$(new-file)"
      },
      {
        "command": "fuliba.openArticle",
        "title": "打开指定文章",
        "category": "福利吧",
        "icon": "$(file-text)"
      },
      {
        "command": "fuliba.search",
        "title": "搜索",
        "category": "福利吧",
        "icon": "$(search)"
      },
      {
        "command": "fuliba.latest",
        "title": "最新福利",
        "category": "福利吧",
        "icon": "$(globe)"
      },
      {
        "command": "fuliba.chooseSort",
        "title": "排序方式",
        "category": "福利吧",
        "icon": "$(list-ordered)"
      },
      {
        "command": "fuliba.toggleSticky",
        "title": "屏蔽/显示置顶帖",
        "category": "福利吧",
        "icon": "$(pin)"
      },
      {
        "command": "fuliba.selectForums",
        "title": "选择显示的版块",
        "category": "福利吧",
        "icon": "$(filter)"
      },
      {
        "command": "fuliba.prevPage",
        "title": "上一页",
        "category": "福利吧",
        "icon": "$(arrow-up)"
      },
      {
        "command": "fuliba.nextPage",
        "title": "下一页",
        "category": "福利吧",
        "icon": "$(arrow-down)"
      },
      {
        "command": "fuliba.jumpFirst",
        "title": "返回首页",
        "category": "福利吧",
        "icon": "$(debug-step-back)"
      },
      {
        "command": "fuliba.copyLink",
        "title": "复制链接",
        "category": "福利吧"
      },
      {
        "command": "fuliba.copyTitleLink",
        "title": "复制标题和链接",
        "category": "福利吧"
      },
      {
        "command": "fuliba.openInBrowser",
        "title": "在浏览器中打开",
        "category": "福利吧"
      },
      {
        "command": "fuliba.markRead",
        "title": "标为已读",
        "category": "福利吧"
      },
      {
        "command": "fuliba.settings",
        "title": "设置",
        "category": "福利吧",
        "icon": "$(gear)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fuliba",
          "title": "福利吧",
          "icon": "resources/fuliba.svg"
        }
      ]
    },
    "views": {
      "fuliba": [
        {
          "id": "fuliba-forums",
          "name": "版块"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "fuliba-forums",
        "contents": "版块树没加载出来。\n\n论坛的版块和帖子需要登录后才能浏览。\n\n[导入 Cookie](command:fuliba.setCookie)\n\n导入方法：浏览器登录 www.wnflb2023.com 后，按 F12 → Network → 刷新页面 → 点任意请求 → 复制 Request Headers 里的 Cookie 值，粘贴进来即可。\n\n---\n\n侧边栏的「最新福利」读的是福利吧官网（门户），**游客就能看，不需要 Cookie**。"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "fuliba.refreshForums",
          "when": "view == fuliba-forums",
          "group": "navigation@1"
        },
        {
          "command": "fuliba.chooseSort",
          "when": "view == fuliba-forums",
          "group": "navigation@2"
        },
        {
          "command": "fuliba.search",
          "when": "view == fuliba-forums",
          "group": "navigation@3"
        },
        {
          "command": "fuliba.setCookie",
          "when": "view == fuliba-forums",
          "group": "navigation@4"
        },
        {
          "command": "fuliba.settings",
          "when": "view == fuliba-forums",
          "group": "navigation@5"
        },
        {
          "command": "fuliba.latest",
          "when": "view == fuliba-forums",
          "group": "navigation@6"
        },
        {
          "command": "fuliba.selectForums",
          "when": "view == fuliba-forums",
          "group": "1_forum@1"
        },
        {
          "command": "fuliba.toggleSticky",
          "when": "view == fuliba-forums",
          "group": "1_forum@2"
        },
        {
          "command": "fuliba.openThread",
          "when": "view == fuliba-forums",
          "group": "2_post@1"
        }
      ],
      "view/item/context": [
        {
          "command": "fuliba.prevPage",
          "when": "view == fuliba-forums && viewItem =~ /^fuliba\\.(forum|portal)$/",
          "group": "inline@0"
        },
        {
          "command": "fuliba.nextPage",
          "when": "view == fuliba-forums && viewItem =~ /^fuliba\\.(forum|portal)$/",
          "group": "inline@1"
        },
        {
          "command": "fuliba.refreshNode",
          "when": "view == fuliba-forums && viewItem =~ /^fuliba\\.(forum|group|portal)$/",
          "group": "inline@2"
        },
        {
          "command": "fuliba.jumpFirst",
          "when": "view == fuliba-forums && viewItem =~ /^fuliba\\.(forum|portal)$/",
          "group": "inline@3"
        },
        {
          "command": "fuliba.copyLink",
          "when": "view == fuliba-forums && viewItem =~ /^fuliba\\.(thread|article)$/"
        },
        {
          "command": "fuliba.copyTitleLink",
          "when": "view == fuliba-forums && viewItem =~ /^fuliba\\.(thread|article)$/"
        },
        {
          "command": "fuliba.openInBrowser",
          "when": "view == fuliba-forums && viewItem =~ /^fuliba\\.(thread|article)$/"
        },
        {
          "command": "fuliba.markRead",
          "when": "view == fuliba-forums && viewItem == fuliba.thread"
        }
      ]
    },
    "configuration": {
      "title": "福利吧",
      "properties": {
        "fuliba.siteUrl": {
          "type": "string",
          "default": "https://www.wnflb2023.com",
          "description": "论坛站点地址"
        },
        "fuliba.portalUrl": {
          "type": "string",
          "default": "https://fuliba2023.net",
          "description": "门户站点地址（福利吧官网）。「最新福利」列表和文章都从这里读，游客可访问，不需要 Cookie"
        },
        "fuliba.threadSort": {
          "type": "string",
          "enum": [
            "dateline",
            "lastpost",
            "heats"
          ],
          "enumDescriptions": [
            "按发帖时间倒序，只看新帖",
            "按最后回复时间倒序，有人回帖就顶上来",
            "按热度倒序，回复和查看多的排前面"
          ],
          "default": "dateline",
          "markdownDescription": "版块内帖子的排序方式。也可以用侧边栏标题栏的「排序方式」按钮切换。"
        },
        "fuliba.hideStickyThreads": {
          "type": "boolean",
          "default": false,
          "description": "在帖子列表中屏蔽置顶帖（侧边栏标题栏也有同名开关，可直接切换）"
        },
        "fuliba.playerSize": {
          "type": "string",
          "default": "480x270",
          "pattern": "^\\s*\\d{2,4}\\s*[x×*]\\s*\\d{2,4}\\s*$",
          "patternErrorMessage": "格式形如 480x270（宽x高，单位像素）",
          "markdownDescription": "帖子详情里播放器的显示尺寸，形如 `480x270`。也可以直接在播放器右上角拖动调整，改一次所有帖子的播放器一起生效。"
        },
        "fuliba.ffmpegPath": {
          "type": "string",
          "default": "",
          "description": "ffmpeg 可执行文件的完整路径（留空则自动探测：Homebrew 常见路径、再到 PATH）。转码视频音轨时用"
        },
        "fuliba.hideReadThreads": {
          "type": "boolean",
          "default": false,
          "description": "在帖子列表中隐藏已读帖子"
        },
        "fuliba.autoFixAudio": {
          "type": "boolean",
          "default": true,
          "description": "打开帖子时自动把视频音轨换成 MP3（需要本机有 ffmpeg）。关掉之后需要在播放器下面手动点「换 MP3 音轨」"
        },
        "fuliba.showAvatar": {
          "type": "boolean",
          "default": false,
          "description": "在帖子详情里显示用户头像（每个楼层一张图，打开会拖慢加载）"
        },
        "fuliba.requestInterval": {
          "type": "number",
          "default": 800,
          "description": "两次请求之间的最小间隔（毫秒），用于降低触发论坛风控的概率"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "art-template": "^4.13.2",
    "axios": "^1.7.0",
    "cheerio": "^1.2.0",
    "domhandler": "^5.0.3",
    "iconv-lite": "^0.6.3"
  }
}
